# Database
DATABASE_URL=postgresql://user:password@localhost:5432/essay_system
VECTOR_STORE=pgvector  # or pinecone, milvus

# Redis
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=essay-system

# LLM Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
KIMI_API_KEY=...

# Default Provider
DEFAULT_LLM_PROVIDER=openai

# Application
SECRET_KEY=your-secret-key-change-this
DEBUG=true
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Worker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Culture Watch
CULTURE_WATCH_SCHEDULE=0 9 * * 1  # Every Monday at 9 AM
MAX_FETCH_RATE=10  # requests per minute

# Quality Controls
MIN_CITATION_COVERAGE=0.7  # 70% of paragraphs must have citations
MIN_SPECIFICITY_SCORE=0.6
FORBIDDEN_PHRASES_FILE=config/forbidden_phrases.txt

# Features
ENABLE_WEB_SEARCH=false  # Enable for Mode B (Open Research)
STRICT_MODE_DEFAULT=true
